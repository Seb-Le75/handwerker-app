# Local development only. Never reuse these credentials outside a developer machine.
DATABASE_URL=postgres://handwerker:handwerker_dev_only@127.0.0.1:5432/handwerker
APP_ENV=development
LOG_LEVEL=info
APP_URL=http://localhost:3000
RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Optional comma-separated hostnames for testing the dev server from an iPad.
ALLOWED_DEV_ORIGINS=192.168.178.92

# Gemeinsame lokale Demo-Daten über den Mac-mini-Server aktivieren.
NEXT_PUBLIC_SHARED_DEMO_STORAGE=false
SHARED_DEMO_STORAGE=false

# Aktive Daten gehören auf die lokale SSD des Mac mini, nicht auf ein SMB-Laufwerk.
HANDWERKER_DATA_DIR="/Users/USERNAME/Library/Application Support/HandwerkerApp/data"

# Die NAS-Freigabe dient als ausfallsicheres Backup-Ziel.
HANDWERKER_BACKUP_DIR="/Volumes/NAS-Archiv/Handwerker-App/backups"
